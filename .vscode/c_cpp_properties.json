{
  "configurations": [
    {
      "name": "Linux",
      "compilerPath": "/usr/bin/cc",
      "cStandard": "c11",
      "intelliSenseMode": "linux-gcc-x64",
      "includePath": [
        "${workspaceFolder}/includes",
        "${workspaceFolder}/src",
        "${workspaceFolder}/tests"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/includes",
          "${workspaceFolder}/src",
          "${workspaceFolder}/tests"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
